# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
*.log
dev.log
dev.out.log
server.log

# sandbox-only artifacts (not part of the deployable site)
/download/
/upload/
/scripts/
/skills/
/.zscripts/
/worklog.md
local-*

# database files (binary, never commit)
/db/
*.db
*.db-journal
*.sqlite
*.sqlite-journal

# editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db

# Claude / Z.ai config
.claude
.z-ai-config
test
prompt
