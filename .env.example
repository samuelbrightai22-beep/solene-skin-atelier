# Environment variables for Solène Skin Atelier
#
# This site is fully static — no component imports Prisma.
# You do NOT need to set DATABASE_URL for the site to run on Vercel.
#
# If you later wire the booking form to persist submissions to Prisma,
# use a serverless Postgres (Neon, Supabase, Vercel Postgres, etc.)
# instead of SQLite, since Vercel's filesystem is read-only.

# Example: Neon Postgres connection string
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/solene?sslmode=require

# Example: SQLite (works locally, NOT on Vercel — filesystem is read-only)
DATABASE_URL=file:./db/custom.db
